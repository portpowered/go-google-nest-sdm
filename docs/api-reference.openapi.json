      "PubSub__pubsubBearerAuth": {
        "bearerFormat": "OAuth 2.0 access token",
        "description": "OAuth 2.0 access token for a principal with pubsub.subscriptions.consume permission on the subscription, such as the Pub/Sub Subscriber role. Authorize the token with https://www.googleapis.com/auth/pubsub or https://www.googleapis.com/auth/cloud-platform scope; SDM account authorization does not grant Pub/Sub IAM access.",
        "scheme": "bearer",
        "type": "http"
      },
      "SDM__sdmBearerAuth": {
        "bearerFormat": "OAuth 2.0 access token",
        "description": "OAuth 2.0 access token for the linked Nest account with https://www.googleapis.com/auth/sdm.service scope and the device or structure permissions granted through Partner Connections Manager.",
        "scheme": "bearer",
        "type": "http"
      }
    }
