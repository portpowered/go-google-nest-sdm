    },
    "/enterprises/{enterpriseId}/devices/{deviceId}:executeCommand": {
      "post": {
        "description": "Use the caller authorization to ExecuteCommand.",
        "operationId": "ExecuteCommand",
        "parameters": [
          {
            "description": "Authorized resource identifier.",
