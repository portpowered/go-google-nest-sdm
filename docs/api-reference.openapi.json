  "info": {
    "description": "REST resources, device commands, OAuth authorization, Pub/Sub event delivery, and camera media downloads for Google Nest Smart Device Management.",
    "title": "Google Nest SDM API reference",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/enterprises/{enterpriseId}/devices": {
      "get": {
        "description": "Use the caller authorization to ListDevices.",
        "operationId": "ListDevices",
        "parameters": [
          {
            "description": "Authorized resource identifier.",
            "in": "path",
            "name": "enterpriseId",
            "required": true,
            "schema": {
              "pattern": "^[^/]+$",
              "type": "string"
            }
          },
          {
            "description": "Requested device filter; service-defined expression.",
            "in": "query",
            "name": "filter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SDM__ListDevicesResponse"
                }
              }
            },
            "description": "Successful operation.",
            "headers": {
              "userId": {
                "description": "Obfuscated user identity.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../api/errors.openapi.yaml#/components/schemas/GoogleErrorResponse"
                }
              }
            },
            "description": "The provider rejected the operation; status and typed error describe the failure."
          }
        },
        "security": [
          {
            "SDM__sdmBearerAuth": []
          }
        ],
        "summary": "List authorized Devices",
        "tags": [
          "Devices"
        ]
      },
      "servers": [
        {
          "url": "https://smartdevicemanagement.googleapis.com/v1"
        }
      ]
    },
